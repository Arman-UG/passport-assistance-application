# ============================================================
# Passport Platform — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=passport_platform
POSTGRES_USER=pp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ---- Java Auth Service ----
AUTH_SERVICE_PORT=8080
# RS256 JWT keys — generate with:
#   openssl genrsa -out auth_private.pem 4096
#   openssl rsa -in auth_private.pem -pubout -out auth_public.pem
# Then base64-encode and paste here (single line, no line breaks):
JWT_PRIVATE_KEY_BASE64=GENERATE_AND_PASTE_BASE64_ENCODED_PRIVATE_KEY
JWT_PUBLIC_KEY_BASE64=GENERATE_AND_PASTE_BASE64_ENCODED_PUBLIC_KEY
JWT_ISSUER=https://passport-platform.local
JWT_AUDIENCE=passport-platform-api
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
JWT_MAX_SESSION_DAYS=30
# Rate limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
INTERNAL_API_SECRET=passport-internal-secret-dev-default-key-32chars

# ---- Python FastAPI App Service ----
APP_SERVICE_PORT=8000
APP_SERVICE_SECRET_KEY=CHANGE_ME_FASTAPI_SECRET_KEY
# JWT public key for token verification (same as above):
JWT_PUBLIC_KEY_BASE64_APP=SAME_AS_JWT_PUBLIC_KEY_BASE64
JWT_ISSUER_APP=https://passport-platform.local
JWT_AUDIENCE_APP=passport-platform-api

# ---- Next.js Frontend ----
FRONTEND_PORT=3000
# Internal URLs (used by BFF server-side, never exposed to browser)
INTERNAL_AUTH_SERVICE_URL=http://auth-service:8080
INTERNAL_APP_SERVICE_URL=http://app-service:8000
# Public URL (used for CORS configuration)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cookie settings
COOKIE_SECURE=false   # Set to true in production (HTTPS)
COOKIE_SAME_SITE=Strict

# ---- File Storage ----
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# ---- Email (optional — set ENABLE_EMAIL=false to skip) ----
ENABLE_EMAIL=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM_NAME=Passport Assistance Platform

# ---- Admin Bootstrap ----
# Used ONCE on first startup to seed the initial admin account.
# Change or remove after first login.
ADMIN_BOOTSTRAP_EMAIL=admin@passportplatform.local
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
